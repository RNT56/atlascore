# .env.example — AtlasCore
#
# Copy to .env (gitignored) and fill in real values: `cp .env.example .env`.
# Secrets are NEVER printed/logged and NEVER committed. A source's
# `credential_ref` names a KEY in this environment, resolved at runtime — it is
# never a secret value itself. Source YAML contains NO secrets and NO private
# endpoints.
#
# Optional alternative: commit an age/SOPS-encrypted `secrets.sops.yaml` whose
# decryption key lives OUTSIDE the repo (password manager / hardware key), and
# at deploy run `infra/decrypt-secrets.sh` (it emits dotenv safely and chmods
# `.env` to 600; see docs/runbooks). Point SOPS_AGE_KEY_FILE at that
# out-of-repo key.

# --- Application ----------------------------------------------------------
# Deployment environment. One of: dev | staging | prod.
APP_ENV=dev

# --- PostgreSQL ----------------------------------------------------------
# infra/docker-compose.yml reads POSTGRES_*; the app + Alembic read DATABASE_URL.
# These MUST AGREE: DATABASE_URL's user/password/db must equal POSTGRES_USER/
# POSTGRES_PASSWORD/POSTGRES_DB, or `make dev && make migrate` fails on auth
# (the compose role is POSTGRES_USER, default `atlascore` — not `atlas`).
# Compose refuses to start without POSTGRES_PASSWORD (it has NO default).
# The values below are a WORKING LOCAL default (same creds CI uses) — CHANGE
# POSTGRES_PASSWORD (and the DATABASE_URL password to match) before any shared
# or exposed deployment; never commit a real password.
POSTGRES_USER=atlascore
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=atlascore

# SQLAlchemy/psycopg DSN for the single PostgreSQL 16 instance (pgvector +
# pg_trgm extensions). Driver MUST be postgresql+psycopg (psycopg v3).
DATABASE_URL=postgresql+psycopg://atlascore:change-me-local-only@localhost:5432/atlascore

# Local-disk raw store: immutable, gzipped, content-addressed payloads.
# The working local default is writable and gitignored. Production/soak must use
# an absolute persistent path; the fail-closed preflight enforces that. Keep it
# on a volume covered by the backup + restore-drill paths.
RAW_STORE_DIR=./var/rawstore

# Optional single-binary search engine. Leave blank to use Postgres FTS only
# (the default). Set only if Postgres FTS is outgrown.
MEILI_URL=

# --- Embeddings (pluggable; ONE active model+dim per deployment) ----------
# Backend: local | sentence-transformers | openai | google. Default dev: local
# (deterministic hashing, offline). `sentence-transformers` = the real local
# embedder (local-embeddings extra); openai/google = cloud (httpx; cloud extra).
# Switching backend/dim is a documented BACKFILL + reindex (`atlas reindex-embeddings`).
EMBEDDING_BACKEND=local
# Model identifier for the chosen backend (recorded as model_version on rows).
# local example: sentence-transformers/all-MiniLM-L6-v2
# openai example: text-embedding-3-small
# google example: text-embedding-004
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Vector dimension. MUST match the chosen model and is FIXED per deployment
# (the pgvector ANN index is built for this dim). all-MiniLM-L6-v2 = 384.
EMBEDDING_DIM=384
# Required ONLY when EMBEDDING_BACKEND is a cloud provider (openai|google).
# WARNING: cloud embeddings egress document text (which can contain PII) to a
# third-party (and likely third-country) processor. Prefer local for PII docs,
# or configure no-training / zero-retention / a DPA. Leave blank for local.
EMBEDDING_API_KEY=
EMBEDDING_REQUEST_TIMEOUT=30
EMBEDDING_MAX_BATCH=64

# --- NER backend (rules | spacy) -----------------------------------------
# rules = deterministic default (offline). spacy needs the local-embeddings extra
# (+ `python -m spacy download en_core_web_sm`); falls back to rules if unavailable.
NER_BACKEND=rules

# --- SEC full-filing extraction via sandboxed Tika (B22) ------------------
# none (default) = metadata-only filings (CI/sandbox-safe, no Java). subprocess =
# `java -jar tika-app.jar --text` (resource-limited, non-root, network-less).
# server = a localhost tika-server. Opt a SEC source in with fetch.params.extract_filings: 'true'.
TIKA_MODE=none
# TIKA_JAR_PATH=/opt/tika/tika-app.jar      # subprocess mode
# TIKA_SERVER_URL=http://127.0.0.1:9998      # server mode (localhost only)
TIKA_TIMEOUT_SECONDS=30
TIKA_MAX_BYTES=16777216
TIKA_RLIMIT_AS_BYTES=1073741824
TIKA_RLIMIT_CPU_SECONDS=60

# --- LLM summaries (pluggable) -------------------------------------------
# Backend: local | api | none.
#   none -> get_document_summary returns only cached summaries, else null+reason.
#   local-> deterministic extractive summarizer (free, offline).
#   api  -> hosted model (cloud-egress caveat as above); a HARD monthly spend cap
#           is enforced via the llm_spend ledger (degrades to cache-only over cap).
LLM_BACKEND=none
# Which hosted provider `api` talks to: openai | anthropic | google.
LLM_PROVIDER=openai
# Model identifier for the chosen LLM backend (recorded as model_version).
LLM_MODEL=
# Required ONLY when LLM_BACKEND=api. Never committed; never logged.
LLM_API_KEY=
LLM_REQUEST_TIMEOUT=60
LLM_MAX_OUTPUT_TOKENS=512
# Request provider no-training / zero-retention options where supported (§16/§20).
CLOUD_NO_TRAIN=true
# HARD monthly spend cap (EUR) enforced when LLM_BACKEND=api. Summaries stop
# (and fall back to cache/null) once the cap is reached.
LLM_MONTHLY_SPEND_CAP_EUR=10

# --- Per-source connector credentials ------------------------------------
# A source's `credentials.ref` (in its YAML) names ONE of these env keys; the
# value is resolved at fetch time and NEVER stored in a DB column or logged.
# FRED (free/official macro API) — get a key at https://fred.stlouisfed.org/.
# Required only when a FRED source is enabled (sources/fred_*.yaml).
FRED_API_KEY=
# NVD (optional): a personal API key unlocks the higher-rate keyed tier (~50 req/30s), sent as the
# `apiKey` request header. Required only when sources/nvd_recent_cves_keyed.yaml is enabled.
# Get one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# GitHub (optional, v1): a personal access token raises the API rate tier from ~60/hour to
# ~5,000/hour, sent as an `Authorization: Bearer` header. Unset ⇒ the GitHub connector fetches
# unauthenticated. Required only when a sources/github_*.yaml is enabled and you want the higher tier.
GITHUB_TOKEN=

# --- HTTP fetcher ---------------------------------------------------------
# Transparent project user-agent WITH a contact, as required by some APIs
# (e.g. SEC EDGAR requires a UA with contact and honors 10 req/s). Use a real,
# reachable contact. Do NOT impersonate a browser.
DEFAULT_USER_AGENT=AtlasCore/0.1.0 (single-operator research; contact: you@example.com)

# --- Alert delivery (pick one channel; leave the others blank) -----------
# Generic webhook (e.g. Slack/Discord-style incoming webhook). Used by the
# daily digest and rule-based alerts.
ALERT_WEBHOOK_URL=
# ntfy.sh topic (alternative simple push channel).
NTFY_TOPIC=
# SMTP (alternative email channel). Leave blank if using a webhook/ntfy.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# --- Liveness heartbeat / dead-man's-switch (optional; RECOMMENDED for unattended ops) ---
# External uptime-monitor ping URL (e.g. a healthchecks.io check URL). The scheduler GETs it after
# each successful tick; if the box/Postgres/scheduler dies the pings stop and the monitor PAGES you.
# Set the monitor's grace period a few ticks above SCHEDULER_TICK_SECONDS (e.g. 5–10 min). Without
# this, the daily digest is the ONLY failure signal and a dead box produces silence, not an alert.
# Carries a per-check token — never logged. Leave blank to disable.
HEARTBEAT_URL=
HEARTBEAT_TIMEOUT=10

# --- Backups (required for an unattended soak) -----------------------------
# Local staging directory plus exactly one offsite destination. The preflight fails closed when
# these are absent. BACKUP_OFFSITE_REMOTE uses rclone; BACKUP_OFFSITE_RSYNC uses rsync/SSH.
BACKUP_DIR=/var/backups/atlascore
BACKUP_RETAIN=14
BACKUP_OFFSITE_REMOTE=
BACKUP_OFFSITE_RSYNC=

# --- Retention windows (control-plane rotation; `atlas audit rotate`, B16) ----
# Duration grammar: Nd | Nw | Nm | Ny | Nh. audit_log: only retention_class='routine' rows beyond
# AUDIT_ROUTINE_RETENTION are rotated; retention_class='purge' (erasure proof) is retained FOREVER
# (R14). crawl_job: only terminal (done|dead) rows beyond CRAWL_JOB_RETENTION are pruned.
AUDIT_ROUTINE_RETENTION=180d
CRAWL_JOB_RETENTION=90d

# --- Alert watchlist (B18; git-tracked governed config) -----------------------
# Path to the watchlist that gates cve_watch/sec_filing (default ./watchlist.yaml). An absent or
# inactive watchlist preserves the pre-B18 fire-on-everything behaviour. No secrets in this file.
# WATCHLIST_PATH=/etc/atlascore/watchlist.yaml

# --- Scheduler + worker loop (B19; seconds) -----------------------------------
# The single-instance scheduler enqueues due per-source fetches each tick and runs housekeeping
# (freshness/alert/partition/audit) inline on these cadences; the worker drains fetch→parse→enrich.
SCHEDULER_TICK_SECONDS=60
FRESHNESS_INTERVAL_SECONDS=900
ALERT_INTERVAL_SECONDS=300
PARTITION_INTERVAL_SECONDS=86400
AUDIT_ROTATION_INTERVAL_SECONDS=86400
WORKER_IDLE_BACKOFF_MAX_SECONDS=30

# --- Logging --------------------------------------------------------------
# Structured logs (structlog). One of: DEBUG | INFO | WARNING | ERROR.
# Secrets/auth headers/cookies/PII are NEVER logged at any level.
LOG_LEVEL=INFO

# --- Secrets management (optional SOPS/age path) --------------------------
# Path to the age private key used to decrypt secrets.sops.yaml at deploy.
# MUST live OUTSIDE the repo. Leave blank to use plain .env only.
SOPS_AGE_KEY_FILE=
