<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent: AtlasCore daily digest. StartCalendarInterval uses the Mac's LOCAL time. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.atlascore.soak.digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__SOAK_DIR__/infra/launchd/bin/soak-digest.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__SOAK_DIR__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>__SOAK_DIR__/var/log/digest.out.log</string>
  <key>StandardErrorPath</key><string>__SOAK_DIR__/var/log/digest.err.log</string>
</dict>
</plist>
