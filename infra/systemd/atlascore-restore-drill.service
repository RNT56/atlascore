[Unit]
Description=AtlasCore disposable restore verification
After=atlascore-stack.service atlascore-backup.service
Requires=atlascore-stack.service

[Service]
Type=oneshot
User=atlascore
WorkingDirectory=/opt/atlascore
EnvironmentFile=/opt/atlascore/.env
ExecStart=/opt/atlascore/infra/restore-latest.sh
